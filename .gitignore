# ============================================================================
# Terraform
# ============================================================================
# Local .terraform directories
**/.terraform/*
.terraform/
.tfshared/

# Project-local provider cache (filesystem mirror + cli.tfrc + canonical lock)
# Built by scripts/auto_test/cache_setup.sh; never committed, never global.
/.terraform-cache/

# State files
*.tfstate
*.tfstate.*
*.tfstate.backup
.tfshared/

# Lock files — not tracked; regenerated locally from the project-local mirror
# (see scripts/auto_test/cache_setup.sh + unify_provider_versions.py).
**/.terraform.lock.hcl
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Variable files (may contain sensitive data)
# Exclude all .tfvars files which may contain sensitive data such as
# passwords, private keys, and other secrets
*.tfvars
*.tfvars.json

# Override files (usually used to override resources locally)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
plan
plan_*.json
plan.json
plan.binary
tfplan.json
tfplan.binary

# CLI configuration files
.terraformrc
terraform.rc

# Ignore transient lock info files
.terraform.tfstate.lock.info

**/.terraform/
**/.tfshared/
**/terraform.tfstate*
**/crash.log
# ============================================================================
# Project Specific
# ============================================================================
# docgen generated artifacts
docs/gcp/_history/
docs/gcp/_changes/

# folder_generator local user state (per-user UI selection, never committed)
scripts/folder_generator/cache/

# auto_test --report output: a CI build artifact for the AutoCapstone backend,
# published via actions/upload-artifact — never committed to the repo.
policy_results.json
