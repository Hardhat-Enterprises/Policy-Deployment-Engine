# ============================================================================
# Terraform
# ============================================================================
# Local .terraform directories
**/.terraform/*
.terraform/

# State files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Lock files (uncomment if you don't want to track lock files)
# .terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Variable files (may contain sensitive data)
# Exclude all .tfvars files which may contain sensitive data such as
# passwords, private keys, and other secrets
*.tfvars
*.tfvars.json

# Override files (usually used to override resources locally)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
plan
plan.json
plan_*.json

# CLI configuration files
.terraformrc
terraform.rc

# Ignore transient lock info files
.terraform.tfstate.lock.info

**/.terraform/
**/.tfshared/
**/terraform.tfstate*
**/crash.log
