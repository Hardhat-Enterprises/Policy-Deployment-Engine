# PDE Gate API Server Configuration

# Server Port
PORT=3847
PDE_API_PORT=3847

# MySQL Database Connection
PDE_DB_HOST=127.0.0.1
PDE_DB_PORT=3306
PDE_DB_NAME=pde_gate
PDE_DB_USER=pde
PDE_DB_PASSWORD=pde

# Request limits for uploading large Terraform plans
PDE_JSON_LIMIT=32mb

# Rego Policies Root Directory (defaults to repo policies/ folder if omitted)
# PDE_POLICIES_ROOT=/path/to/policies

# Signs login session tokens (12h). Required, at least 32 characters, when
# NODE_ENV=production; generate one with: openssl rand -hex 32
# GATE_SESSION_SECRET=

# Per-client-IP limits on register and login (429 when exceeded).
# PDE_LOGIN_RATE_LIMIT=10
# PDE_LOGIN_RATE_WINDOW_MINUTES=15
# PDE_REGISTER_RATE_LIMIT=5
# PDE_REGISTER_RATE_WINDOW_MINUTES=60

# Behind a reverse proxy, the hop count (usually 1) or the proxies' addresses, so
# rate limits see the real client IP rather than the proxy's.
# PDE_TRUST_PROXY=1
