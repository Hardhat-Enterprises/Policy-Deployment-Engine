# PDE Gate API Server Configuration

# Server Port
PORT=3847
PDE_API_PORT=3847

# MySQL Database Connection
PDE_DB_HOST=127.0.0.1
PDE_DB_PORT=3306
PDE_DB_NAME=pde_gate
PDE_DB_USER=pde
PDE_DB_PASSWORD=pde

# Request limits for uploading large Terraform plans
PDE_JSON_LIMIT=32mb

# Rego Policies Root Directory (defaults to repo policies/ folder if omitted)
# PDE_POLICIES_ROOT=/path/to/policies
