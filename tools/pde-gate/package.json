{
  "name": "pde-gate",
  "version": "0.1.0",
  "description": "Run PDE OPA policies against a Terraform plan JSON",
  "type": "module",
  "bin": {
    "pde-gate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsx src/cli.ts check --plan ../../samples/org-input/plan.json --policies ../../policies",
    "start": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
