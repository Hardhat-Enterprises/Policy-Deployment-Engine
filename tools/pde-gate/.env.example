# PDE Gate CLI Environment Configuration
# After deploying the API, update PDE_API_URL to point to your hosted endpoint.

# Hosted API Endpoint (e.g., https://pde-gate-api.yourcompany.com or http://127.0.0.1:3847)
PDE_API_URL=http://127.0.0.1:3847

# CI / CD Authentication Secrets (obtained from `pde-gate register` or `pde-gate login`)
PDE_ORG_ID=org_xxxxxxxxxxxx
PDE_API_KEY=pde_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
