{
    "type": "google.api.Service",
    "configVersion": 3,
    "name": "demo-api.endpoints.demo-project.cloud.goog",
    "title": "Demo API",
    "apis": [
      {
        "name": "DemoService"
      }
    ],
    "usage": {
      "rules": [
        {
          "selector": "*",
          "allowUnregisteredCalls": false
        }
      ]
    },
    "backend": {
      "rules": [
        {
          "selector": "*",
          "address": "https://backend.demo-project.cloud.goog"
        }
      ]
    }
  }
  