{
  "name": "baseline-usa",
  "description": "Org config allowing ONLY US regions",
  "platforms": ["gcp"],
  "policy_groups": {
    "google_vpc_access_connector": ["region", "ip_cidr_range"],
    "google_compute_disk": ["zone"]
  },
  "variables": {
    "approved_regions": ["us-central1", "us-east1"],
    "approved_zones": ["us-central1-a", "us-east1-b"],
    "google_provider_version": "7.37.0"
  }
}
