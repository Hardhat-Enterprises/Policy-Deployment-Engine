{
 "format_version": "1.0",
 "provider_schemas": {
  "registry.terraform.io/hashicorp/google": {
   "resource_schemas": {
    "google_compute_network_firewall_policy_rule": {
     "block": {
      "attributes": {
       "priority": {
        "type": "string",
        "description": "An integer indicating the priority of a rule in the list.",
        "required": true,
        "optional": false
       },
       "action": {
        "type": "string",
        "description": "The Action to perform when the client connection triggers the rule.",
        "required": true,
        "optional": false
       },
       "direction": {
        "type": "string",
        "description": "The direction in which this rule applies.",
        "required": true,
        "optional": false
       },
       "enable_logging": {
        "type": "bool",
        "description": "Denotes whether to enable logging for a particular rule.",
        "required": false,
        "optional": true
       },
       "description": {
        "type": "string",
        "description": "An optional description for this resource.",
        "required": false,
        "optional": true
       },
       "dest_network_scope": {
        "type": "string",
        "description": "Network scope of the destination for the rule.",
        "required": false,
        "optional": true
       },
       "security_profile_group": {
        "type": "string",
        "description": "A fully-qualified URL of a security profile group.",
        "required": false,
        "optional": true
       }
      }
     }
    },
    "google_compute_snapshot": {
     "block": {
      "attributes": {
       "name": {
        "type": "string",
        "description": "Name of the resource.",
        "required": true,
        "optional": false
       },
       "source_disk": {
        "type": "string",
        "description": "A reference to the disk used to create this snapshot.",
        "required": true,
        "optional": false
       },
       "labels": {
        "type": [
         "map",
         "string"
        ],
        "description": "Labels to apply to this Snapshot.",
        "required": false,
        "optional": true
       }
      },
      "block_types": {
       "source_disk_encryption_key": {
        "nesting_mode": "list",
        "max_items": 1,
        "block": {
         "attributes": {
          "raw_key": {
           "type": "string",
           "description": "Specifies a 256-bit customer-supplied encryption key.",
           "required": false,
           "optional": true
          },
          "kms_key_self_link": {
           "type": "string",
           "description": "The name of the encryption key that is stored in Google Cloud KMS.",
           "required": false,
           "optional": true
          },
          "kms_key_service_account": {
           "type": "string",
           "description": "The service account used for the encryption request.",
           "required": false,
           "optional": true
          }
         }
        }
       }
      }
     }
    },
    "google_compute_region_commitment": {
     "block": {
      "attributes": {
       "name": {
        "type": "string",
        "description": "Name of the resource.",
        "required": true,
        "optional": false
       },
       "plan": {
        "type": "string",
        "description": "The plan for this commitment.",
        "required": true,
        "optional": false
       },
       "region": {
        "type": "string",
        "description": "URL of the region where this commitment may be used.",
        "required": false,
        "optional": true
       }
      }
     }
    },
    "google_compute_brand_new": {
     "block": {
      "attributes": {
       "name": {
        "type": "string",
        "description": "Name of the resource.",
        "required": true,
        "optional": false
       },
       "setting": {
        "type": "string",
        "description": "Some new setting.",
        "required": false,
        "optional": true
       }
      }
     }
    }
   }
  }
 }
}